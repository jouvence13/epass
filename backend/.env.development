# ==============================================================================
# CONFIGURATION BACKEND - DÉVELOPPEMENT LOCAL (DOCKER / LOCAL)
# ==============================================================================
APP_NAME="ePass Campus Bénin API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Sécurité & Tokens JWT (Clés de développement)
SECRET_KEY="epass_campus_secret_key_development_random_hash_key_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
QR_ENCRYPTION_KEY="epass_aes_256_secret_key_32_bytes_dev!"

# Base de Données PostgreSQL + PostGIS (Conteneur Docker postgres)
POSTGRES_SERVER="uac_buspass_postgres"
POSTGRES_PORT=5432
POSTGRES_USER="uac_buspass_user"
POSTGRES_PASSWORD="uac_buspass_password"
POSTGRES_DB="uac_buspass_db"
DATABASE_URL="postgresql+asyncpg://uac_buspass_user:uac_buspass_password@uac_buspass_postgres:5432/uac_buspass_db"
SYNC_DATABASE_URL="postgresql://uac_buspass_user:uac_buspass_password@uac_buspass_postgres:5432/uac_buspass_db"

# Redis & Broker Celery (Conteneur Docker redis)
REDIS_HOST="uac_buspass_redis"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://uac_buspass_redis:6379/0"
CELERY_BROKER_URL="redis://uac_buspass_redis:6379/0"
CELERY_RESULT_BACKEND="redis://uac_buspass_redis:6379/1"

# Passerelles Paiement (Mode Sandbox Bénin)
FEDAPAY_SECRET_KEY="fp_sandbox_sample_key"
FEDAPAY_PUBLIC_KEY="fp_sandbox_public_key"
FEDAPAY_ENVIRONMENT="sandbox"

KKIAPAY_PUBLIC_KEY="kkiapay_sample_public"
KKIAPAY_PRIVATE_KEY="kkiapay_sample_private"
KKIAPAY_SECRET="kkiapay_sample_secret"
KKIAPAY_SANDBOX=True

# Dossier des Justificatifs KYC
UPLOAD_DIR="./uploads/kyc"
