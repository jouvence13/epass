# ==============================================================================
# CONFIGURATION BACKEND - SERVEUR DE PRODUCTION
# ==============================================================================
APP_NAME="ePass Campus Bénin API"
APP_ENV="production"
DEBUG=False
API_V1_PREFIX="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Sécurité & Tokens JWT (Production - Clés fortes obligatoires)
SECRET_KEY="CHANGE_ME_SUPER_STRONG_PRODUCTION_SECRET_KEY_HEX_256_BITS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
QR_ENCRYPTION_KEY="CHANGE_ME_AES_256_KEY_PROD_32_CHARS_EXACT"

# Base de Données PostgreSQL + PostGIS Production
POSTGRES_SERVER="db.epass.uac.bj"
POSTGRES_PORT=5432
POSTGRES_USER="epass_prod_user"
POSTGRES_PASSWORD="CHANGE_ME_DB_PRODUCTION_PASSWORD"
POSTGRES_DB="epass_prod_db"
DATABASE_URL="postgresql+asyncpg://epass_prod_user:CHANGE_ME_DB_PRODUCTION_PASSWORD@db.epass.uac.bj:5432/epass_prod_db"
SYNC_DATABASE_URL="postgresql://epass_prod_user:CHANGE_ME_DB_PRODUCTION_PASSWORD@db.epass.uac.bj:5432/epass_prod_db"

# Redis & Broker Celery Production
REDIS_HOST="redis.epass.uac.bj"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://redis.epass.uac.bj:6379/0"
CELERY_BROKER_URL="redis://redis.epass.uac.bj:6379/0"
CELERY_RESULT_BACKEND="redis://redis.epass.uac.bj:6379/1"

# Passerelles Paiement Live Bénin (FedaPay & KKiaPay Production)
FEDAPAY_SECRET_KEY="fp_live_real_production_secret_key"
FEDAPAY_PUBLIC_KEY="fp_live_real_production_public_key"
FEDAPAY_ENVIRONMENT="live"

KKIAPAY_PUBLIC_KEY="kkiapay_live_public_key"
KKIAPAY_PRIVATE_KEY="kkiapay_live_private_key"
KKIAPAY_SECRET="kkiapay_live_secret_key"
KKIAPAY_SANDBOX=False

# Dossier des Justificatifs KYC (Stockage Sécurisé ou Volume Dédié)
UPLOAD_DIR="/data/epass/uploads/kyc"
