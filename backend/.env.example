# ==============================================================================
# UAC-BusPass - Configuration d'Environnement
# ==============================================================================

# Application
APP_NAME="UAC-BusPass API"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Sécurité & Tokens JWT
SECRET_KEY="replace_with_a_super_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 heures
REFRESH_TOKEN_EXPIRE_DAYS=30
QR_ENCRYPTION_KEY="replace_with_32_bytes_base64_encoded_aes_key____"

# Base de Données PostgreSQL + PostGIS
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="uac_buspass_user"
POSTGRES_PASSWORD="uac_buspass_password"
POSTGRES_DB="uac_buspass_db"
DATABASE_URL="postgresql+asyncpg://uac_buspass_user:uac_buspass_password@localhost:5432/uac_buspass_db"
SYNC_DATABASE_URL="postgresql://uac_buspass_user:uac_buspass_password@localhost:5432/uac_buspass_db"

# Redis & Broker Celery
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Passerelles Paiement Mobile Money Bénin
FEDAPAY_SECRET_KEY="fp_sandbox_secret_key_here"
FEDAPAY_PUBLIC_KEY="fp_sandbox_public_key_here"
FEDAPAY_ENVIRONMENT="sandbox" # sandbox ou live

KKIAPAY_PUBLIC_KEY="kkiapay_public_key_here"
KKIAPAY_PRIVATE_KEY="kkiapay_private_key_here"
KKIAPAY_SECRET="kkiapay_secret_here"
KKIAPAY_SANDBOX=True

# Notifications Push & SMS
FIREBASE_CREDENTIALS_PATH="./firebase_credentials.json"
SMS_GATEWAY_API_KEY="sms_provider_api_key_here"
SMS_SENDER_ID="UAC-BusPass"

# Stockage Local / S3 pour Documents KYC
UPLOAD_DIR="./uploads/kyc"
