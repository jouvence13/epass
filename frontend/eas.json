{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bee2-2c0f-53c0-618-9c00-db91-3bc3-36df-8940.ngrok-free.app"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview-device": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bee2-2c0f-53c0-618-9c00-db91-3bc3-36df-8940.ngrok-free.app"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "enterpriseProvisioning": "adhoc"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bee2-2c0f-53c0-618-9c00-db91-3bc3-36df-8940.ngrok-free.app"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
