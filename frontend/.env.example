# ==============================================================================
# CONFIGURATION FRONTEND - EXEMPLE DE TEMPLATE
# ==============================================================================
# Copiez ce fichier vers .env pour définir vos variables d'environnement locales :
#   cp .env.development .env
# ==============================================================================

# Environnement d'exécution : development | preview | production
EXPO_PUBLIC_ENV=development

# URL racine de l'API Backend (sans slash final) :
# - Local Web / Dev : http://localhost:8001
# - Réseau Wi-Fi local : http://192.168.1.87:8001
# - Émulateur Android : http://10.0.2.2:8001
# - Production : https://api.epass.uac.bj
EXPO_PUBLIC_API_URL=http://localhost:8001

# Délai maximum d'attente des requêtes HTTP en millisecondes
EXPO_PUBLIC_API_TIMEOUT_MS=10000
