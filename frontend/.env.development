# ==============================================================================
# CONFIGURATION FRONTEND - DÉVELOPPEMENT LOCAL (WEB & EXPO)
# ==============================================================================
# Port de l'API Backend local : 8001
# Pour tester sur navigateur web : http://localhost:8001
# Pour tester sur simulateur / émulateur : http://10.0.2.2:8001 (Android) ou http://localhost:8001 (iOS)
# Pour tester sur mobile physique Wi-Fi : http://<VOTRE_IP_LOCALE>:8001 (ex: http://192.168.1.87:8001)
# ==============================================================================

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:8001
EXPO_PUBLIC_API_TIMEOUT_MS=10000
